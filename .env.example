# CarbonBridge — Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to git.

# Supabase (public — safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://ixoxhzlwaspjfvbgfgff.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role (server-only — NEVER expose to browser)
# Import only from @/lib/supabase-server (createServiceClient), never from supabase.ts
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Cron secret — sent as x-cron-secret header by the cron job that calls
# DELETE /api/credits/reserve to release expired reservations.
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Resend (email)
RESEND_API_KEY=your_resend_key_here

# Vercel Analytics (auto-injected by Vercel — set here for local testing)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
